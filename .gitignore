# never commit test data (2.5GB+ of orthos/DSMs) - belt and suspenders
# alongside the extension rules below, so any file type landing in here
# is still caught, not just the ones we happened to think of
testdata/

# dev-only NTFS junction (see tools/qgis-*-dev.bat) - not a real directory,
# must never be walked/committed, and isn't portable across machines anyway
.qgis_dev/

# never commit rasters
*.tif
*.tiff
*.ovr
*.aux.xml
*.msk

# never commit icon SVG masters - they live in a separate brand assets
# folder outside this repo; only the exported PNGs (raster_optimiser/icons/)
# are shipped with the plugin
*.svg

# never commit built plugin packages - these are release artifacts, not
# source, and plugins.qgis.org forbids zipped files in the source
# repository; an accidental commit would need history rewriting to undo,
# not just a follow-up commit
*.zip
*.7z

# python junk
__pycache__/
*.pyc
*.pyo
.venv/

# os junk
Thumbs.db
.DS_Store